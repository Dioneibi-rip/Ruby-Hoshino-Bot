# -----------------------------------------------------------------------------
# Ruby Hoshino Bot - Plantilla de variables de entorno
# -----------------------------------------------------------------------------
# 1) Copia este archivo y renómbralo a `.env` antes de iniciar el bot:
#      cp .env.example .env
# 2) Nunca subas tu `.env` real a GitHub: ahí van contraseñas y secretos.
# 3) Si dejas MONGODB_URI vacío, el bot usará SQLite local automáticamente.
# -----------------------------------------------------------------------------

# URL de conexión de MongoDB Atlas.
# - Modo local / Plug & Play: déjalo vacío para usar SQLite sin configurar nada.
# - Modo producción: pega aquí tu URI de Atlas, por ejemplo:
#   mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Nombre lógico de la base de datos dentro de MongoDB.
# Solo se usa cuando MONGODB_URI tiene valor.
MONGODB_DB_NAME=ruby_hoshino

# Tamaño máximo del pool de conexiones MongoDB.
# Sube este valor si alojas muchos Sub-Bots y tu plan de Atlas lo permite.
MONGODB_POOL_SIZE=50

# Número mínimo de conexiones MongoDB que Mongoose intentará mantener abiertas.
MONGODB_MIN_POOL_SIZE=2

# Tiempo máximo, en milisegundos, para encontrar un servidor MongoDB disponible.
# Si MongoDB no responde a tiempo, el bot hará fallback automático a SQLite.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Tiempo máximo, en milisegundos, para operaciones de socket MongoDB.
MONGODB_SOCKET_TIMEOUT_MS=45000

# Activa el prefetch masivo de grupos al conectar Sub-Bots.
# Recomendado: false. Déjalo apagado para evitar rate-overlimit de WhatsApp/Baileys.
SUBBOT_GROUP_PREFETCH_ON_CONNECT=false

# Intervalo mínimo entre llamadas globales a groupFetchAllParticipating, en ms.
# Aumentarlo reduce el riesgo de rate limits cuando hay muchas sesiones.
GROUP_FETCH_ALL_MIN_INTERVAL_MS=180000

# Tiempo de enfriamiento después de un rate limit de grupos, en ms.
GROUP_FETCH_ALL_RETRY_DELAY_MS=600000
