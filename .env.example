# -----------------------------------------------------------------------------
# Ruby Hoshino Bot - variables de entorno
# -----------------------------------------------------------------------------
# 1) Copia este archivo y renómbralo a `.env` antes de iniciar el bot:
#      cp .env.example .env
# 2) Nunca subas tu `.env` real a GitHub: ahí van contraseñas y secretos.
# 3) La persistencia del bot es 100% local con SQLite.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# IA de Ruby (LangChain + Groq) - OBLIGATORIO para el modulo autonomo
# -----------------------------------------------------------------------------
# Consigue tu key gratis en https://console.groq.com/keys
# Sin esta variable el agente de Ruby queda desactivado (el resto del bot sigue).
GROQ_API_KEY=

# Modelo de Groq. Por defecto: openai/gpt-oss-120b
RUBY_GROQ_MODEL=openai/gpt-oss-120b

# Mensajes de historial que recuerda Ruby por usuario (ventana de memoria).
RUBY_MEMORY_WINDOW=10

# Maximo de pasos del bucle agentico (llamadas a herramientas) por mensaje.
# Al llegar al techo Ruby avisa y continua en segundo plano en vez de abandonar.
RUBY_MAX_ITERATIONS=25

# Recomendado: false. Déjalo apagado para evitar rate-overlimit de WhatsApp/Baileys.

# Intervalo mínimo entre llamadas globales a groupFetchAllParticipating, en ms.
# Aumentarlo reduce el riesgo de rate limits cuando hay muchas sesiones.
GROUP_FETCH_ALL_MIN_INTERVAL_MS=180000

# Tiempo de enfriamiento después de un rate limit de grupos, en ms.
GROUP_FETCH_ALL_RETRY_DELAY_MS=600000

# Ajustes SQLite opcionales.
SQLITE_BATCH_DELAY_MS=5000
SQLITE_TEMP_CLEANUP_INTERVAL_MS=3600000
BAILEYS_STORE_MAX_MESSAGES_PER_CHAT=50
BAILEYS_STORE_INACTIVE_CHAT_TTL_MS=86400000
